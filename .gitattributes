# Normalize to LF in the repository, whatever the checkout platform does locally.
# Without this, editing a file from a Windows script rewrites every line and a
# six-line change reviews as a whole-file diff.
* text=auto eol=lf

# Binary: never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.ico   binary
*.woff  binary
*.woff2 binary
