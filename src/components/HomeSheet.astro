---
import { ui, siteConfig } from "../data/site";
import { certifications, stats } from "../data/resume";
import TopologyFigure from "./TopologyFigure.astro";

interface Props { lang: "en" | "es" }
const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;

const figures = [
  { value: `${stats.yearsExperience}`, unit: "+",   label: h.figures.years },
  { value: `${stats.certifications}`,  unit: "",    label: h.figures.certs },
  { value: `${stats.cloudProviders}`,  unit: "",    label: h.figures.clouds },
  { value: "CNCF",                     unit: "",    label: h.figures.oss },
];

const stack = [
  "Kubernetes", "AKS", "EKS", "Docker", "Helm", "GitHub Actions",
  "Azure DevOps", "GitHub Enterprise Cloud", "GCP", "AWS", "Azure", "OCI",
  "Terraform", "Ansible", "Python", "Golang", "Bash", "Prometheus",
  "Grafana", "GitHub Copilot", "GHAS", "Microcks", "MCP", "ArgoCD", "OPA",
];
---

<!-- ── Hero ────────────────────────────────────────────── -->
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">{siteConfig.title[lang]}</p>

    <h1>
      {h.headlineLead}<br />
      <span class="accent">{h.headlineAccent}</span>
    </h1>

    <p class="lede">{h.lede}</p>

    <div class="btn-row">
      <a href={`/${lang}/resume/`} class="btn btn-primary">
        {h.ctaRecord}
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </a>
      <a href={siteConfig.cvUrl} download class="btn">{t.common.downloadCv}</a>
    </div>
  </div>

  <div class="hero-figure">
    <TopologyFigure caption={h.figCaption} center={h.figCenter} />
  </div>
</section>

<!-- ── Figures ─────────────────────────────────────────── -->
<section class="panel sheet-gap">
  <div class="panel-head">
    <span class="panel-title">{h.figuresPanel}</span>
    <span class="panel-note">
      <span class="status-dot" aria-hidden="true"></span>
      {siteConfig.availableForWork ? t.common.available : t.common.notAvailable}
    </span>
  </div>
  <div class="cells cells-4">
    {figures.map(f => (
      <div class="cell">
        <p class="figure-value">{f.value}{f.unit && <span class="unit">{f.unit}</span>}</p>
        <p class="figure-label">{f.label}</p>
      </div>
    ))}
  </div>
</section>

<!-- ── Capabilities ────────────────────────────────────── -->
<section class="panel sheet-gap">
  <div class="panel-head">
    <span class="panel-title">{h.capabilitiesPanel}</span>
    <span class="panel-note">{t.services.length}</span>
  </div>
  <div class="cells cells-2">
    {t.services.map(s => (
      <div class="cell capability">
        <span class="capability-tick" aria-hidden="true"></span>
        <div>
          <h3>{s.title}</h3>
          <p class="capability-desc">{s.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ── Certifications ──────────────────────────────────── -->
<section class="panel sheet-gap">
  <div class="panel-head">
    <span class="panel-title">{h.certsPanel}</span>
    <span class="panel-note">{stats.certifications} {h.certsNote}</span>
  </div>
  <div class="cells cells-4">
    {certifications.map(group => (
      <div class="cell">
        <p class={`vendor vendor-${group.color}`}>{group.vendor}</p>
        <div class="tag-row">
          {group.items.map(item => (
            item.url
              ? <a href={item.url} target="_blank" rel="noopener" class={`tag cert-${group.color}`}>{item.name}</a>
              : <span class={`tag cert-${group.color}`}>{item.name}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ── Stack ───────────────────────────────────────────── -->
<section class="panel sheet-gap">
  <div class="panel-head">
    <span class="panel-title">{h.stackPanel}</span>
    <span class="panel-note">{stack.length}</span>
  </div>
  <div class="stack-body">
    {stack.map(tech => <span class="tag">{tech}</span>)}
  </div>
</section>

<style>
  .hero {
    display: grid;
    /* The headline needs the wider column; the figure reads fine smaller. */
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-copy { min-width: 0; }
  .hero h1 { margin: 0; }
  .hero h1 .accent { color: var(--accent); }
  .hero .btn-row { margin-top: 2.5rem; }
  .hero-figure { min-width: 0; }

  .sheet-gap { margin-top: clamp(3rem, 6vw, 4.5rem); }

  .panel-note { display: inline-flex; align-items: center; gap: 8px; }

  .capability { display: flex; gap: 1rem; align-items: flex-start; }
  /* A drafted tick mark instead of a number. */
  .capability-tick {
    width: 14px; height: 14px; flex-shrink: 0;
    margin-top: 0.35rem;
    border-left: 1px solid var(--accent);
    border-bottom: 1px solid var(--accent);
  }
  .capability h3 { margin-bottom: 0.5rem; }
  .capability-desc { font-size: 0.9375rem; line-height: 1.62; }

  .tag-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 0.875rem; }
  a.tag { text-decoration: none; }
  a.tag:hover { background: var(--accent-soft); }

  .stack-body { display: flex; flex-wrap: wrap; gap: 6px; padding: 1.375rem; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-figure { order: -1; }
  }
</style>
