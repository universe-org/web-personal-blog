---
import { ui } from "../data/site";
import { postsByDate } from "../data/posts";

interface Props { lang: "en" | "es" }
const { lang } = Astro.props;
const b = ui[lang].blog;

const locale = lang === "en" ? "en-US" : "es-PE";
const fmt = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString(locale, {
    year: "numeric", month: "long", day: "numeric", timeZone: "UTC",
  });
---

<header>
  <h1>{b.heading}<span class="dot">.</span></h1>
  <p class="lede">{b.lede}</p>
</header>

<section class="panel sheet-gap">
  <div class="panel-head">
    <span class="panel-title">{b.heading}</span>
    <span class="panel-note">{postsByDate.length}</span>
  </div>
  <div class="rows">
    {postsByDate.map((post, i) => (
      <article class="note-row">
        <div class="note-side">
          <span class="note-no">{String(i + 1).padStart(2, "0")}</span>
          <time class="note-date" datetime={post.date}>{fmt(post.date)}</time>
          <span class="note-read">{post.readingTime} {b.minRead}</span>
        </div>
        <div class="note-main">
          <h3>{post.title[lang]}</h3>
          <p class="note-excerpt">{post.excerpt[lang]}</p>
          <div class="note-foot">
            <div class="tag-row">
              {post.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
            {!post.published && <span class="note-soon">{b.soon}</span>}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .dot { color: var(--accent); }
  .sheet-gap { margin-top: clamp(2.5rem, 5vw, 4rem); }

  .rows { display: flex; flex-direction: column; gap: 1px; background: var(--rule-2); }

  .note-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 1.75rem;
    padding: 1.625rem 1.375rem;
    background: var(--bg);
    transition: background var(--ease);
  }
  .note-row:hover { background: var(--bg-2); }

  .note-side { display: flex; flex-direction: column; gap: 6px; }
  .note-no {
    font-family: var(--font-mono); font-size: 0.6875rem;
    color: var(--accent); letter-spacing: 0.08em;
  }
  .note-date {
    font-family: var(--font-mono); font-size: 0.6875rem;
    letter-spacing: 0.06em; color: var(--text-3);
  }
  .note-read {
    font-family: var(--font-mono); font-size: 0.6875rem;
    color: var(--text-3);
  }

  .note-main h3 { margin-bottom: 0.625rem; }
  .note-excerpt { font-size: 0.9375rem; line-height: 1.65; }

  .note-foot {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap; margin-top: 1.125rem;
  }
  .tag-row { display: flex; flex-wrap: wrap; gap: 5px; }
  .note-soon {
    font-family: var(--font-mono); font-size: 0.625rem;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-3); border: 1px solid var(--rule-2);
    padding: 3px 8px; white-space: nowrap;
  }

  @media (max-width: 780px) {
    .note-row { grid-template-columns: 1fr; gap: 0.875rem; }
    .note-side { flex-direction: row; flex-wrap: wrap; gap: 12px; align-items: baseline; }
  }
</style>
