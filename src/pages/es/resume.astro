---
import Base from "../../layouts/Base.astro";
import { ui, siteConfig } from "../../data/site";
import { certifications, experience, openSource, skills, education } from "../../data/resume";

const lang = "es";
const t = ui[lang].resume;
---
<Base lang={lang} title={t.heading}>
  <section class="section" style="padding-top:0.5rem;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:1rem;">
      <div>
        <p class="section-heading">Currículum</p>
        <h1>Currículum<span class="heading-dot">.</span></h1>
        <div class="heading-line"></div>
      </div>
      <a href={siteConfig.cvUrl} download style="display:inline-flex;align-items:center;gap:6px;font-size:0.75rem;font-family:var(--font-mono);padding:8px 14px;border:1px solid var(--border-2);border-radius:var(--radius);color:var(--text-2);text-decoration:none;margin-top:1rem;">
        ↓ {t.download}
      </a>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start;">
      <div>
        <div style="margin-bottom:2rem;">
          <p class="section-heading">Certificaciones</p>
          {certifications.map(group => (
            <div style="margin-bottom:1rem;">
              <p style={`font-size:1.35rem;font-weight:800;margin-bottom:10px;display:block;letter-spacing:-0.01em;color:${ group.color === "cncf" ? "#2dd4a0" : group.color === "hashi" ? "#a78bfa" : group.color === "azure" ? "#5b9cf6" : group.color === "aws" ? "#f59e0b" : group.color === "github" ? "#c9c8c4" : "#9a9890" }`}>{group.vendor}</p>
              <div style="display:flex;flex-wrap:wrap;gap:6px;">
                {group.items.map(item => <span class={`tag cert-${group.color}`}>{item.name}</span>)}
              </div>
            </div>
          ))}
        </div>
        <div style="margin-bottom:2rem;">
          <p class="section-heading">Skills</p>
          {skills.map(group => (
            <div style="margin-bottom:0.875rem;">
              <p style="font-size:0.68rem;font-family:var(--font-mono);color:var(--text-3);margin-bottom:5px;">{group.category[lang]}</p>
              <div style="display:flex;flex-wrap:wrap;gap:5px;">{group.items.map(item => <span class="tag">{item}</span>)}</div>
            </div>
          ))}
        </div>
        <div>
          <p class="section-heading">Educación</p>
          {education.map(edu => (
            <div class="card" style="margin-bottom:8px;">
              <p style="font-weight:600;font-size:0.875rem;color:var(--text);">{edu.degree[lang]}</p>
              <p style="font-size:0.75rem;color:var(--teal);font-family:var(--font-mono);margin-top:4px;">{edu.institution}</p>
            </div>
          ))}
        </div>
      </div>
      <div>
        <div style="margin-bottom:2rem;">
          <p class="section-heading">Experiencia</p>
          {experience.map(job => (
            <div class="card" style="margin-bottom:10px;">
              <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:4px;">
                <p style="font-weight:600;font-size:0.875rem;color:var(--text);">{job.role[lang]}</p>
                <span style="font-size:0.68rem;font-family:var(--font-mono);color:var(--text-3);white-space:nowrap;">{job.period.replace("present",t.present)}</span>
              </div>
              <p style="font-size:0.75rem;color:var(--teal);font-family:var(--font-mono);margin-bottom:8px;">{job.company} · {job.location}</p>
              <ul style="padding-left:1rem;display:flex;flex-direction:column;gap:5px;">
                {job.bullets[lang].map(b => <li style="font-size:0.8125rem;color:var(--text-2);line-height:1.55;">{b}</li>)}
              </ul>
              {job.tags && <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px;">{job.tags.map(tag => <span class="tag">{tag}</span>)}</div>}
            </div>
          ))}
        </div>
        <div>
          <p class="section-heading">Open Source</p>
          {openSource.map(oss => (
            <div class="card">
              <p style="font-weight:600;font-size:0.875rem;color:var(--text);">{oss.project} <span style="font-size:0.7rem;color:var(--teal);font-family:var(--font-mono);">{oss.org}</span></p>
              <p style="font-size:0.82rem;color:var(--text-2);margin-top:8px;line-height:1.6;">{oss.description[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .cert-cncf   { color:#2dd4a0;border-color:rgba(45,212,160,0.3)!important; }
  .cert-hashi  { color:#a78bfa;border-color:rgba(167,139,250,0.3)!important; }
  .cert-azure  { color:#5b9cf6;border-color:rgba(91,156,246,0.3)!important; }
  .cert-aws    { color:#f59e0b;border-color:rgba(245,158,11,0.3)!important; }
  .cert-github { color:#c9c8c4;border-color:rgba(201,200,196,0.3)!important; }
  .cert-gray   { color:#9a9890;border-color:rgba(154,152,144,0.2)!important; }

  .vendor-label {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
    display: inline-block;
    letter-spacing: -0.01em;
  }
  .vendor-cncf   { color: #2dd4a0; }
  .vendor-github { color: #c9c8c4; }
  .vendor-hashi  { color: #a78bfa; }
  .vendor-azure  { color: #5b9cf6; }
  .vendor-aws    { color: #f59e0b; }
  .vendor-gray   { color: #9a9890; }
</style>