---
import Base from "../../layouts/Base.astro";
import { ui } from "../../data/site";
import { projects } from "../../data/projects";

const lang = "es";
const t = ui[lang].portfolio;
---
<Base lang={lang} title={t.heading.replace(".","")}>
  <section class="section" style="padding-top:0.5rem;">
    <p class="section-heading">portafolio</p>
    <h1>Portafolio<span class="heading-dot">.</span></h1>
    <div class="heading-line"></div>
    <div style="display:flex;gap:8px;margin-bottom:2rem;flex-wrap:wrap;" id="filter-bar">
      {[
        {id:"all",label:t.filterAll},{id:"cloud",label:t.filterCloud},
        {id:"devsecops",label:t.filterDevsecops},{id:"automation",label:t.filterAutomation},
        {id:"oss",label:t.filterOss},
      ].map(f => (
        <button data-filter={f.id} class={`filter-btn ${f.id==="all"?"active":""}`}>{f.label}</button>
      ))}
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;" id="projects-grid">
      {projects.map(project => (
        <div class="card project-card" data-categories={project.categories.join(",")}>
          {project.featured && <span style="font-size:0.65rem;font-family:var(--font-mono);color:var(--teal);display:block;margin-bottom:6px;">★ destacado</span>}
          <h3 style="color:var(--text);font-size:0.875rem;margin-bottom:8px;">{project.title[lang]}</h3>
          <p style="font-size:0.8125rem;color:var(--text-2);line-height:1.6;flex:1;">{project.description[lang]}</p>
          <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:12px;">{project.tags.map(tag=><span class="tag">{tag}</span>)}</div>
          {(project.repoUrl||project.demoUrl)&&(
            <div style="display:flex;gap:10px;margin-top:12px;padding-top:12px;border-top:1px solid var(--border);">
              {project.repoUrl&&<a href={project.repoUrl} target="_blank" rel="noopener" style="font-size:0.72rem;font-family:var(--font-mono);color:var(--accent);text-decoration:none;">{t.viewRepo} →</a>}
              {project.demoUrl&&<a href={project.demoUrl} target="_blank" rel="noopener" style="font-size:0.72rem;font-family:var(--font-mono);color:var(--teal);text-decoration:none;">{t.viewDemo} →</a>}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
<script>
  document.querySelectorAll(".filter-btn").forEach(btn=>{
    btn.addEventListener("click",()=>{
      const f=btn.dataset.filter;
      document.querySelectorAll(".filter-btn").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      document.querySelectorAll(".project-card").forEach(card=>{
        card.style.display=f==="all"||card.dataset.categories.split(",").includes(f)?"flex":"none";
      });
    });
  });
</script>
<style>
  .filter-btn{font-size:0.72rem;font-family:var(--font-mono);padding:5px 12px;border-radius:var(--radius);background:transparent;border:1px solid var(--border-2);color:var(--text-2);cursor:pointer;transition:all var(--ease);}
  .filter-btn.active{background:var(--bg-3);color:var(--accent);border-color:var(--accent-2);}
  .project-card{display:flex;flex-direction:column;}
  @media(max-width:600px){#projects-grid{grid-template-columns:1fr;}}
</style>