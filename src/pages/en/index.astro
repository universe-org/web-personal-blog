---
import Base from "../../layouts/Base.astro";
import { ui, siteConfig } from "../../data/site";
import { certifications, stats } from "../../data/resume";

const lang = "en";
const t = ui[lang];
---
<Base lang={lang}>
  <section class="section" style="padding-top: 0.5rem;">
    <p class="section-heading">About me</p>
    <h1>About me<span class="heading-dot">.</span></h1>
    <div class="heading-line"></div>
    <p style="max-width: 580px; font-size: 0.9375rem; line-height: 1.8;">
      {t.about.intro}
    </p>

    <!-- Stats -->
    <div class="stats-grid">
      {[
        { value: `${stats.yearsExperience}+`, label: "Years exp." },
        { value: `${stats.certifications}`,   label: "Certifications" },
        { value: `${stats.cloudProviders}`,   label: "Cloud providers" },
        { value: `${stats.openSourceProjects}`, label: "OSS projects" },
      ].map(s => (
        <div class="stat-card">
          <p class="stat-value">{s.value}</p>
          <p class="stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <p class="section-heading">What I'm Doing</p>
    <div class="services-grid">
      {t.services.map(s => (
        <div class="service-card">
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Tech stack -->
  <section class="section">
    <p class="section-heading">Tech Stack</p>
    <div style="display: flex; flex-wrap: wrap; gap: 7px;">
      {[
        "Kubernetes","AKS","EKS","Docker","Helm","GitHub Actions",
        "Azure DevOps","GitHub Enterprise Cloud","GCP","AWS","Azure","OCI",
        "Terraform","Ansible","Python","Golang","Bash","Prometheus",
        "Grafana","GitHub Copilot","GHAS","Microcks","MCP","ArgoCD","OPA",
      ].map(tech => <span class="tag">{tech}</span>)}
    </div>
  </section>

  <!-- Certs highlight -->
  <section class="section">
    <p class="section-heading">Certifications</p>
    <div style="display: flex; flex-direction: column; gap: 8px;">
      {certifications.map(group => (
        <div class="card" style="display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
          <p style={`font-size:0.85rem;font-weight:700;font-family:var(--font-mono);min-width:160px;padding-top:3px;color:${group.color==="cncf"?"#60a5fa":group.color==="hashi"?"#a78bfa":group.color==="azure"?"#7dd3fc":group.color==="aws"?"#f59e0b":group.color==="github"?"#c9c8c4":"#9a9890"}`}>{group.vendor}</p>
          <div style="display: flex; flex-wrap: wrap; gap: 6px; flex: 1;">
            {group.items.map(item => (
              item.url
                ? <a href={item.url} target="_blank" rel="noopener" class={`tag cert-${group.color}`} style="text-decoration:none">{item.name}</a>
                : <span class={`tag cert-${group.color}`}>{item.name}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 2.5rem;
  }
  .stat-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 0.75rem;
    text-align: center;
  }
  .stat-value {
    font-size: 1.875rem; font-weight: 800;
    color: var(--text); font-family: var(--font-mono);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.68rem; color: var(--text-3);
    font-family: var(--font-mono); margin-top: 6px;
  }
  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .service-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    transition: border-color var(--ease);
  }
  .service-card:hover { border-color: var(--border-2); }
  .service-title {
    font-size: 0.8125rem; font-weight: 600;
    color: var(--teal); font-family: var(--font-mono);
    margin-bottom: 8px;
  }
  .service-desc { font-size: 0.8375rem; line-height: 1.65; color: var(--text-2); }
  .cert-vendor {
    font-size: 0.68rem; font-family: var(--font-mono);
    color: var(--text-3); min-width: 160px; padding-top: 3px;
  }
  .cert-cncf   { color: #60a5fa; border-color: rgba(96,165,250,0.3) !important; }
  .cert-hashi  { color: #a78bfa; border-color: rgba(167,139,250,0.3) !important; }
  .cert-azure  { color: #7dd3fc; border-color: rgba(125,211,252,0.3) !important; }
  .cert-aws    { color: #f59e0b; border-color: rgba(245,158,11,0.3) !important; }
  .cert-github { color: #c9c8c4; border-color: rgba(201,200,196,0.3) !important; }
  .cert-gray   { color: #9a9890; border-color: rgba(154,152,144,0.2) !important; }

  @media (max-width: 600px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .services-grid { grid-template-columns: 1fr; }
  }
</style>