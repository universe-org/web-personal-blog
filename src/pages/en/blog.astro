---
import Base from "../../layouts/Base.astro";
import { ui } from "../../data/site";

const lang = "en";
const t = ui[lang].blog;

const posts = [
  {
    slug: "devsecops-github-actions",
    title: "Embedding security into CI/CD pipelines with GitHub Actions",
    excerpt: "A practical guide to adding container scanning, secret detection, and IaC linting to your GitHub Actions workflows without slowing down developers.",
    date: "2025-03-12",
    tags: ["DevSecOps", "GitHub Actions", "Trivy", "Gitleaks"],
    readingTime: 8,
  },
  {
    slug: "kubestronaut-journey",
    title: "How I became a Kubestronaut: passing all 5 CNCF Kubernetes exams",
    excerpt: "My study strategy, timeline, and tips for passing KCNA, KCSA, CKA, CKAD, and CKS back to back — including what almost tripped me up on each one.",
    date: "2025-01-28",
    tags: ["Kubernetes", "CNCF", "Certifications", "Career"],
    readingTime: 12,
  },
  {
    slug: "arc-runners-aks",
    title: "Ephemeral GitHub Actions runners on AKS with Actions Runner Controller",
    excerpt: "How to set up elastic, ephemeral self-hosted runners on Azure Kubernetes Service using ARC — including KEDA autoscaling and common pitfalls around pip storage exhaustion.",
    date: "2025-05-04",
    tags: ["GitHub Actions", "AKS", "Kubernetes", "ARC"],
    readingTime: 10,
  },
  {
    slug: "github-copilot-enterprise-rollout",
    title: "Rolling out GitHub Copilot at enterprise scale: lessons learned",
    excerpt: "What actually works when deploying Copilot to hundreds of developers — licensing governance, prompt guidelines, productivity metrics, and how to handle the skeptics.",
    date: "2025-02-17",
    tags: ["GitHub Copilot", "GitHub Enterprise", "DevEx"],
    readingTime: 9,
  },
  {
    slug: "terraform-azure-governance",
    title: "Azure governance at scale with Terraform and Azure Policy",
    excerpt: "Structuring Management Groups, RBAC, and Policy definitions as Terraform modules to enforce org-wide guardrails without creating toil for engineering teams.",
    date: "2024-11-05",
    tags: ["Terraform", "Azure", "Azure Policy", "IaC"],
    readingTime: 11,
  },
  {
    slug: "microcks-contract-testing",
    title: "API contract testing in CI with Microcks and GitHub Actions",
    excerpt: "An introduction to Microcks as a CNCF-backed approach to API mocking and contract testing, with a walkthrough of integrating it into a GitHub Actions pipeline.",
    date: "2024-09-22",
    tags: ["Microcks", "API Testing", "CNCF", "GitHub Actions"],
    readingTime: 7,
  },
];

function formatDate(d: string) {
  return new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---
<Base lang={lang} title="Blog">
  <section class="section" style="padding-top: 0.5rem;">
    <p class="section-heading">// blog</p>
    <h1>Blog<span class="heading-dot">.</span></h1>
    <div class="heading-line"></div>
    <p style="margin-bottom: 2.5rem; max-width: 520px;">
      Thoughts on DevSecOps, cloud platforms, Kubernetes, and the tools I use day to day.
    </p>

    <div class="posts-list">
      {posts.map((post, i) => (
        <article class="post-card">
          <div class="post-meta">
            <time class="post-date">{formatDate(post.date)}</time>
            <span class="post-read">{post.readingTime} {t.minRead}</span>
          </div>
          <h2 class="post-title">{post.title}</h2>
          <p class="post-excerpt">{post.excerpt}</p>
          <div class="post-footer">
            <div class="post-tags">
              {post.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
            <span class="post-coming">Coming soon</span>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .posts-list { display: flex; flex-direction: column; gap: 2px; }

  .post-card {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    transition: border-color var(--ease), background var(--ease);
    cursor: default;
  }
  .post-card:hover {
    border-color: var(--border-2);
    background: var(--bg-3);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .post-date {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-3);
  }
  .post-read {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-3);
    padding-left: 12px;
    border-left: 1px solid var(--border-2);
  }

  .post-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.35;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .post-excerpt {
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .post-tags { display: flex; flex-wrap: wrap; gap: 5px; }
  .post-coming {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--text-3);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 4px;
  }
</style>