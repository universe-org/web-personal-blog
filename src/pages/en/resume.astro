---
// src/pages/en/resume.astro
import Base from "../../layouts/Base.astro";
import { ui, siteConfig } from "../../data/site";
import { certifications, experience, openSource, skills, education } from "../../data/resume";

const lang = "en";
const t = ui[lang].resume;
---
<Base lang={lang} title={t.heading}>
  <section class="section" style="padding-top: 0.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 12px;">
      <div>
        <p class="section-heading">// resume</p>
        <h1>{t.heading}</h1>
      </div>
      <a href={siteConfig.cvUrl} download
        style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-family: var(--font-mono); padding: 8px 16px; border: 1px solid var(--border-2); border-radius: var(--radius); color: var(--text-2); text-decoration: none; transition: all 150ms ease; white-space: nowrap;"
        onmouseover="this.style.color='var(--text)';this.style.borderColor='var(--accent)'"
        onmouseout="this.style.color='var(--text-2)';this.style.borderColor='var(--border-2)'">
        ↓ {t.download}
      </a>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start;">

      <!-- Left column -->
      <div>
        <!-- Certifications -->
        <div class="section">
          <p class="section-heading">// {t.certHeading.toLowerCase()}</p>
          {certifications.map(group => (
            <div style="margin-bottom: 1.25rem;">
              <p style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-3); margin-bottom: 8px;">
                {group.vendor}
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                {group.items.map(item => (
                  item.url
                    ? <a href={item.url} target="_blank" rel="noopener" class={`tag cert-${group.color}`} style="text-decoration: none;">{item.name}</a>
                    : <span class={`tag cert-${group.color}`}>{item.name}</span>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Skills -->
        <div class="section">
          <p class="section-heading">// {t.skillHeading.toLowerCase()}</p>
          {skills.map(group => (
            <div style="margin-bottom: 1rem;">
              <p style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-3); margin-bottom: 6px;">
                {group.category[lang]}
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 5px;">
                {group.items.map(item => <span class="tag">{item}</span>)}
              </div>
            </div>
          ))}
        </div>

        <!-- Education -->
        <div class="section">
          <p class="section-heading">// {t.eduHeading.toLowerCase()}</p>
          {education.map(edu => (
            <div class="card">
              <p style="font-weight: 500; font-size: 0.875rem; color: var(--text);">{edu.degree[lang]}</p>
              <p style="font-size: 0.8rem; color: var(--text-2); margin-top: 3px;">{edu.institution}</p>
              <div style="display: flex; gap: 8px; margin-top: 6px; flex-wrap: wrap;">
                <span class="tag">{edu.location}</span>
                <span class="tag">{edu.year}</span>
                {edu.gpa && <span class="tag">GPA {edu.gpa}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right column -->
      <div>
        <!-- Experience -->
        <div class="section">
          <p class="section-heading">// {t.expHeading.toLowerCase()}</p>
          {experience.map(job => (
            <div class="card" style="margin-bottom: 10px;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; flex-wrap: wrap;">
                <p style="font-weight: 500; font-size: 0.9rem; color: var(--text);">{job.role[lang]}</p>
                <span style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-3); white-space: nowrap;">
                  {job.period.replace("present", t.present)}
                </span>
              </div>
              <p style="font-size: 0.78rem; color: var(--teal); margin-top: 3px; font-family: var(--font-mono);">
                {job.company} · {job.location}
              </p>
              <ul style="margin-top: 10px; padding-left: 1rem; display: flex; flex-direction: column; gap: 5px;">
                {job.bullets[lang].map(b => (
                  <li style="font-size: 0.82rem; color: var(--text-2); line-height: 1.55;">{b}</li>
                ))}
              </ul>
              {job.tags && (
                <div style="display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px;">
                  {job.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Open source -->
        <div class="section">
          <p class="section-heading">// {t.ossHeading}</p>
          {openSource.map(oss => (
            <div class="card">
              <div style="display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap;">
                <div>
                  <p style="font-weight: 500; font-size: 0.9rem; color: var(--text);">{oss.project}</p>
                  <p style="font-size: 0.75rem; color: var(--teal); font-family: var(--font-mono); margin-top: 3px;">{oss.org}</p>
                </div>
                <span style="font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-3);">{oss.period}</span>
              </div>
              <p style="font-size: 0.82rem; color: var(--text-2); margin-top: 8px; line-height: 1.55;">{oss.description[lang]}</p>
              <div style="display: flex; gap: 8px; margin-top: 10px; align-items: center; flex-wrap: wrap;">
                {oss.tags?.map(tag => <span class="tag">{tag}</span>)}
                <a href={oss.url} target="_blank" rel="noopener" style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--accent); margin-left: auto;">
                  {oss.url.replace("https://", "")} →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Base>

<style>
  .cert-cncf   { color: #2dd4a0; border-color: rgba(45,212,160,0.3); }
  .cert-hashi  { color: #a78bfa; border-color: rgba(167,139,250,0.3); }
  .cert-azure  { color: #5b9cf6; border-color: rgba(91,156,246,0.3); }
  .cert-aws    { color: #f59e0b; border-color: rgba(245,158,11,0.3); }
  .cert-github { color: #9a9890; border-color: rgba(154,152,144,0.3); }
  .cert-gcp    { color: #f87171; border-color: rgba(248,113,113,0.3); }
</style>
