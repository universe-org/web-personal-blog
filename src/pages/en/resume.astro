---
import Base from "../../layouts/Base.astro";
import { ui, siteConfig } from "../../data/site";
import { certifications, experience, openSource, skills, education } from "../../data/resume";

const lang = "en";
const t = ui[lang].resume;
---
<Base lang={lang} title={t.heading}>
  <section class="section" style="padding-top:0.5rem;">
    <div class="resume-header">
      <div>
        <p class="section-heading">Resume</p>
        <h1>Resume<span class="heading-dot">.</span></h1>
        <div class="heading-line"></div>
      </div>
      <a href={siteConfig.cvUrl} download class="download-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        {t.download}
      </a>
    </div>

    <div class="resume-grid">

      <!-- Left -->
      <div>
        <div class="resume-section">
          <p class="section-heading">Certifications</p>
          {certifications.map(group => (
            <div class="cert-group">
              <p class="cert-vendor-label">{group.vendor}</p>
              <div class="cert-tags">
                {group.items.map(item => (
                  item.url
                    ? <a href={item.url} target="_blank" rel="noopener" class={`tag cert-${group.color}`} style="text-decoration:none">{item.name}</a>
                    : <span class={`tag cert-${group.color}`}>{item.name}</span>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="resume-section">
          <p class="section-heading">Skills</p>
          {skills.map(group => (
            <div class="skill-group">
              <p class="skill-cat">{group.category[lang]}</p>
              <div style="display:flex;flex-wrap:wrap;gap:5px;">
                {group.items.map(item => <span class="tag">{item}</span>)}
              </div>
            </div>
          ))}
        </div>

        <div class="resume-section">
          <p class="section-heading">Education</p>
          {education.map(edu => (
            <div class="card" style="margin-bottom:8px;">
              <p style="font-weight:600;font-size:0.875rem;color:var(--text);">{edu.degree[lang]}</p>
              <p style="font-size:0.78rem;color:var(--teal);font-family:var(--font-mono);margin-top:4px;">{edu.institution}</p>
              <span class="tag" style="margin-top:8px;display:inline-block;">{edu.location}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right -->
      <div>
        <div class="resume-section">
          <p class="section-heading">Experience</p>
          {experience.map(job => (
            <div class="card exp-card">
              <div class="exp-header">
                <p class="exp-role">{job.role[lang]}</p>
                <span class="exp-date">{job.period.replace("present", t.present)}</span>
              </div>
              <p class="exp-company">{job.company} · {job.location}</p>
              <ul class="exp-bullets">
                {job.bullets[lang].map(b => <li>{b}</li>)}
              </ul>
              {job.tags && (
                <div style="display:flex;flex-wrap:wrap;gap:5px;margin-top:10px;">
                  {job.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="resume-section">
          <p class="section-heading">Open Source</p>
          {openSource.map(oss => (
            <div class="card">
              <div class="exp-header">
                <p class="exp-role">{oss.project}</p>
                <span class="exp-date">{oss.period}</span>
              </div>
              <p class="exp-company">{oss.org}</p>
              <p style="font-size:0.82rem;color:var(--text-2);margin-top:8px;line-height:1.6;">{oss.description[lang]}</p>
              <div style="display:flex;gap:8px;margin-top:10px;align-items:center;flex-wrap:wrap;">
                {oss.tags?.map(tag => <span class="tag">{tag}</span>)}
                <a href={oss.url} target="_blank" rel="noopener" style="font-size:0.72rem;font-family:var(--font-mono);color:var(--accent);margin-left:auto;">
                  {oss.url.replace("https://","")} →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .resume-header { display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem;flex-wrap:wrap;gap:12px; }
  .download-btn {
    display:inline-flex;align-items:center;gap:6px;
    font-size:0.75rem;font-family:var(--font-mono);
    padding:8px 14px;border:1px solid var(--border-2);
    border-radius:var(--radius);color:var(--text-2);
    text-decoration:none;transition:all var(--ease);
    margin-top:1rem;
  }
  .download-btn:hover { color:var(--accent);border-color:rgba(91,156,246,0.4); }
  .resume-grid { display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;align-items:start; }
  .resume-section { margin-bottom:2rem; }
  .cert-group { margin-bottom:1rem; }
  .cert-vendor-label { font-size:0.85rem;font-weight:600;color:var(--text);margin-bottom:8px;letter-spacing:-0.01em; }
  .cert-tags { display:flex;flex-wrap:wrap;gap:8px; }
  .tag { font-size:0.8rem!important; }
  .skill-group { margin-bottom:0.875rem; }
  .skill-cat { font-size:0.68rem;font-family:var(--font-mono);color:var(--text-3);margin-bottom:5px; }
  .exp-card { margin-bottom:10px; }
  .exp-header { display:flex;justify-content:space-between;align-items:flex-start;gap:8px;flex-wrap:wrap;margin-bottom:4px; }
  .exp-role { font-weight:600;font-size:0.875rem;color:var(--text); }
  .exp-date { font-size:0.68rem;font-family:var(--font-mono);color:var(--text-3);white-space:nowrap; }
  .exp-company { font-size:0.75rem;color:var(--teal);font-family:var(--font-mono);margin-bottom:8px; }
  .exp-bullets { padding-left:1rem;display:flex;flex-direction:column;gap:5px; }
  .exp-bullets li { font-size:0.8125rem;color:var(--text-2);line-height:1.55; }
  .cert-cncf   { color:#0d4a38;background:#2dd4a0;border-color:#2dd4a0!important;font-weight:600; }
  .cert-hashi  { color:#2d1a6e;background:#a78bfa;border-color:#a78bfa!important;font-weight:600; }
  .cert-azure  { color:#0a2a6e;background:#5b9cf6;border-color:#5b9cf6!important;font-weight:600; }
  .cert-aws    { color:#5a3200;background:#f59e0b;border-color:#f59e0b!important;font-weight:600; }
  .cert-github { color:#2a2a2a;background:#c9c8c4;border-color:#c9c8c4!important;font-weight:600; }
  .cert-gray   { color:#1a1a2e;background:#7c7b89;border-color:#7c7b89!important;font-weight:600; }
  @media (max-width:640px) { .resume-grid { grid-template-columns:1fr; } }
</style>