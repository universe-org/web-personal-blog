---
import { siteConfig, ui } from "../data/site";

interface Props {
  lang: "en" | "es";
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const pageTitle = title
  ? `${title} — ${siteConfig.name}`
  : `${siteConfig.name} — ${siteConfig.title[lang]}`;
const pageDesc = description ?? siteConfig.description[lang];
const canonical = `${siteConfig.url}${Astro.url.pathname}`;
const altLang = lang === "en" ? "es" : "en";
const altPath = Astro.url.pathname.replace(`/${lang}`, `/${altLang}`);

const navItems = [
  { href: `/${lang}/`,           label: t.nav.about,     icon: "M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" },
  { href: `/${lang}/resume/`,    label: t.nav.resume,    icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM8 13h8v1H8v-1zm0 3h8v1H8v-1zm0-6h5v1H8v-1z" },
  { href: `/${lang}/portfolio/`, label: t.nav.portfolio, icon: "M3 3h8v8H3V3zm0 10h8v8H3v-8zm10 0h8v8h-8v-8zm0-10h8v8h-8V3z" },
  { href: `/${lang}/blog/`,      label: t.nav.blog,      icon: "M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z" },
  { href: `/${lang}/contact/`,   label: t.nav.contact,   icon: "M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" },
];

const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={altLang} href={`${siteConfig.url}${altPath}`} />
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Syne:wght@400;500;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

<!-- Geometric decoration (top-right) -->
<div class="geo-decoration" aria-hidden="true">
  <svg width="320" height="320" viewBox="0 0 320 320" fill="none">
    <polygon points="160,0 320,80 320,240 160,320 0,240 0,80" fill="none" stroke="rgba(91,156,246,0.06)" stroke-width="1"/>
    <polygon points="160,30 290,100 290,220 160,290 30,220 30,100" fill="none" stroke="rgba(45,212,160,0.05)" stroke-width="1"/>
    <rect x="120" y="40" width="80" height="80" rx="4" fill="rgba(91,156,246,0.04)" transform="rotate(15 160 80)"/>
    <rect x="60" y="160" width="60" height="60" rx="4" fill="rgba(45,212,160,0.04)" transform="rotate(-10 90 190)"/>
    <rect x="200" y="180" width="50" height="50" rx="4" fill="rgba(245,158,11,0.04)" transform="rotate(20 225 205)"/>
  </svg>
</div>

<!-- Mobile toggle -->
<button id="mobile-toggle" aria-label="Toggle navigation">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
    <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
  </svg>
</button>

<div class="layout">

  <!-- ── Sidebar ── -->
  <aside id="sidebar">

    <!-- Profile card -->
    <div class="profile-card">
      <div class="avatar" id="avatar-el">
        DA
      </div>
      <div class="profile-info">
        <p class="profile-name">{siteConfig.name}</p>
        <p class="profile-handle">@{siteConfig.handle}</p>
      </div>
    </div>

    <!-- Nav -->
    <nav class="sidebar-nav" aria-label="Main navigation">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== `/${lang}/` && currentPath.startsWith(item.href));
        return (
          <a href={item.href} class={`nav-item ${isActive ? "active" : ""}`}>
            <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={item.icon}/>
            </svg>
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <!-- Meta info -->
    <div class="sidebar-meta">
      <div class="meta-row">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        <span>{siteConfig.email}</span>
      </div>
      <div class="meta-row">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <span>{siteConfig.location[lang]}</span>
      </div>
      <div class="meta-row status-row">
        <span class={`status-dot ${siteConfig.availableForWork ? "available" : "unavailable"}`}></span>
        <span class={siteConfig.availableForWork ? "status-open" : "status-closed"}>
          {siteConfig.availableForWork
            ? (lang === "en" ? "Open to work" : "Disponible")
            : (lang === "en" ? "Not available" : "No disponible")}
        </span>
      </div>
    </div>

    <!-- Socials -->
    <div class="sidebar-socials">
      <a href={siteConfig.social.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48v-1.7C6.73 19.91 6.14 18 6.14 18c-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85.004 1.71.115 2.51.337 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10z"/></svg>
      </a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
      </a>
    </div>

    <!-- Bottom controls -->
    <div class="sidebar-bottom">
      <div class="lang-toggle">
        <a href={Astro.url.pathname.replace(`/${lang}`, "/en")} class={lang === "en" ? "active" : ""}>EN</a>
        <a href={Astro.url.pathname.replace(`/${lang}`, "/es")} class={lang === "es" ? "active" : ""}>ES</a>
      </div>
      <a href={siteConfig.cvUrl} download class="cv-btn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        CV
      </a>
    </div>

  </aside>

  <!-- ── Main ── -->
  <main id="main">
    <div id="main-inner">
      <slot />
    </div>
  </main>

</div>

<script>
  const toggle = document.getElementById("mobile-toggle");
  const sidebar = document.getElementById("sidebar");
  toggle?.addEventListener("click", () => sidebar?.classList.toggle("open"));
  document.addEventListener("click", (e) => {
    if (!sidebar?.contains(e.target as Node) && !toggle?.contains(e.target as Node)) {
      sidebar?.classList.remove("open");
    }
  });
</script>

<style is:global>
  :root {
    --bg:       #1a1b22;
    --bg-2:     #20212b;
    --bg-3:     #272830;
    --bg-4:     #2e2f3a;
    --border:   rgba(255,255,255,0.07);
    --border-2: rgba(255,255,255,0.13);
    --text:     #e8e6df;
    --text-2:   #9a9890;
    --text-3:   #55545c;
    --accent:   #5b9cf6;
    --accent-2: #3b82f6;
    --teal:     #2dd4a0;
    --amber:    #f59e0b;
    --font-sans:"Syne", system-ui, sans-serif;
    --font-mono:"JetBrains Mono", monospace;
    --radius:   8px;
    --radius-lg:14px;
    --nav-w:    260px;
    --ease:     150ms ease;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { background: var(--bg); color: var(--text); font-family: var(--font-sans); scroll-behavior: smooth; }

  /* ── Layout ── */
  .layout { display: flex; min-height: 100vh; }

  /* ── Geo decoration ── */
  .geo-decoration {
    position: fixed;
    top: -40px; right: -40px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.6;
  }

  /* ── Sidebar ── */
  #sidebar {
    position: fixed;
    top: 0; left: 0;
    width: var(--nav-w);
    height: 100vh;
    background: var(--bg-2);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem;
    z-index: 100;
    overflow-y: auto;
    gap: 0;
  }

  /* Profile card */
  .profile-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: var(--bg-3);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-lg);
    margin-bottom: 1.5rem;
  }
  .avatar {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-2), var(--teal));
    display: flex; align-items: center; justify-content: center;
    font-size: 0.875rem; font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    font-family: var(--font-mono);
    overflow: hidden;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .profile-name { font-size: 0.875rem; font-weight: 700; color: var(--text); line-height: 1.2; }
  .profile-handle { font-size: 0.7rem; color: var(--teal); font-family: var(--font-mono); margin-top: 2px; }

  /* Nav */
  .sidebar-nav { display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px;
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-2);
    transition: all var(--ease);
    border-left: 2px solid transparent;
  }
  .nav-item:hover { background: var(--bg-3); color: var(--text); border-left-color: var(--border-2); }
  .nav-item.active { background: var(--bg-3); color: var(--accent); border-left-color: var(--accent); }
  .nav-icon { flex-shrink: 0; opacity: 0.7; }
  .nav-item.active .nav-icon,
  .nav-item:hover .nav-icon { opacity: 1; }

  /* Meta */
  .sidebar-meta {
    display: flex; flex-direction: column; gap: 7px;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin: 1rem 0;
  }
  .meta-row {
    display: flex; align-items: center; gap: 7px;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-3);
  }
  .meta-row svg { flex-shrink: 0; }
  .status-row { margin-top: 2px; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .status-dot.available { background: var(--teal); box-shadow: 0 0 6px var(--teal); }
  .status-dot.unavailable { background: var(--text-3); }
  .status-open { color: var(--teal); font-weight: 500; }
  .status-closed { color: var(--text-3); }

  /* Socials */
  .sidebar-socials { display: flex; gap: 10px; padding: 0 2px; margin-bottom: 1rem; }
  .sidebar-socials a {
    color: var(--text-3);
    text-decoration: none;
    transition: color var(--ease);
    display: flex; align-items: center;
  }
  .sidebar-socials a:hover { color: var(--accent); }

  /* Bottom */
  .sidebar-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border); }
  .lang-toggle { display: flex; gap: 3px; }
  .lang-toggle a {
    font-size: 0.7rem; font-family: var(--font-mono);
    color: var(--text-3); text-decoration: none;
    padding: 4px 8px; border-radius: 5px;
    transition: all var(--ease);
  }
  .lang-toggle a.active,
  .lang-toggle a:hover { background: var(--bg-4); color: var(--text); }
  .cv-btn {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 0.7rem; font-family: var(--font-mono);
    color: var(--accent); text-decoration: none;
    padding: 5px 10px; border: 1px solid rgba(91,156,246,0.3);
    border-radius: 5px; transition: all var(--ease);
  }
  .cv-btn:hover { background: rgba(91,156,246,0.1); }

  /* ── Main ── */
  #main {
    margin-left: var(--nav-w);
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  #main-inner {
    width: 100%;
    max-width: 820px;
    padding: 3rem 3rem 5rem;
  }

  /* Mobile */
  #mobile-toggle {
    display: none;
    position: fixed; top: 1rem; right: 1rem; z-index: 200;
    background: var(--bg-2); border: 1px solid var(--border-2);
    border-radius: var(--radius); padding: 8px 10px;
    cursor: pointer; color: var(--text);
  }

  @media (max-width: 768px) {
    #sidebar { transform: translateX(-100%); transition: transform 0.25s ease; }
    #sidebar.open { transform: translateX(0); }
    #main { margin-left: 0; }
    #main-inner { padding: 5rem 1.25rem 3rem; }
    #mobile-toggle { display: flex; align-items: center; justify-content: center; }
    .geo-decoration { display: none; }
  }

  /* ── Typography ── */
  h1 { font-size: clamp(2.25rem, 5vw, 3.25rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; }
  h2 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.25rem; }
  h3 { font-size: 1rem; font-weight: 600; }
  p  { font-size: 1rem; line-height: 1.8; color: var(--text-2); }

  /* ── Components ── */
  .tag {
    display: inline-block; font-size: 0.72rem;
    font-family: var(--font-mono); padding: 3px 9px;
    border-radius: 4px; border: 1px solid var(--border-2);
    color: var(--text-2); background: var(--bg-3);
  }
  .section { margin-bottom: 3.5rem; }
  .section-heading {
    font-size: 0.68rem; font-family: var(--font-mono);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-3); margin-bottom: 1.25rem;
  }
  .card {
    background: var(--bg-2); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 1.25rem 1.5rem;
  }
  .card + .card { margin-top: 10px; }

  /* Heading accent dot */
  .heading-dot { color: var(--teal); }
  .heading-line {
    width: 40px; height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--teal));
    border-radius: 2px; margin: 12px 0 1.5rem;
  }

  a { color: var(--accent); }
  code { font-family: var(--font-mono); font-size: 0.85em; }
</style>
</body>
</html>