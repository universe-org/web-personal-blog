---
// src/layouts/Base.astro
import { siteConfig, ui } from "../data/site";

interface Props {
  lang: "en" | "es";
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const pageTitle = title
  ? `${title} — ${siteConfig.name}`
  : `${siteConfig.name} — ${siteConfig.title[lang]}`;
const pageDesc = description ?? siteConfig.description[lang];
const canonical = `${siteConfig.url}${Astro.url.pathname}`;
const altLang = lang === "en" ? "es" : "en";
const altPath = Astro.url.pathname.replace(`/${lang}`, `/${altLang}`);
---
<!doctype html>
<html lang={lang} class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={altLang} href={`${siteConfig.url}${altPath}`} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image"       content={`${siteConfig.url}/og-image.png`} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Syne:wght@400;500;700&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <style is:global>
    :root {
      --bg:        #0d0e12;
      --bg-2:      #13141a;
      --bg-3:      #1a1b23;
      --border:    rgba(255,255,255,0.08);
      --border-2:  rgba(255,255,255,0.14);
      --text:      #e8e6df;
      --text-2:    #9a9890;
      --text-3:    #5a5856;
      --accent:    #5b9cf6;
      --accent-2:  #3b82f6;
      --teal:      #2dd4a0;
      --amber:     #f59e0b;
      --font-sans: "Syne", system-ui, sans-serif;
      --font-mono: "JetBrains Mono", monospace;
      --radius:    8px;
      --radius-lg: 14px;
      --nav-w:     260px;
      --transition: 150ms ease;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { background: var(--bg); color: var(--text); font-family: var(--font-sans); scroll-behavior: smooth; }

    body {
      display: flex;
      min-height: 100vh;
    }

    /* ── Sidebar nav ── */
    #sidebar {
      position: fixed;
      top: 0; left: 0;
      width: var(--nav-w);
      height: 100vh;
      background: var(--bg-2);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      padding: 2rem 1.5rem;
      z-index: 100;
      overflow-y: auto;
    }

    .sidebar-avatar {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: var(--bg-3);
      border: 1px solid var(--border-2);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 1rem;
      font-family: var(--font-mono);
      overflow: hidden;
    }
    .sidebar-avatar img { width: 100%; height: 100%; object-fit: cover; }

    .sidebar-name {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.2;
    }
    .sidebar-title {
      font-size: 0.75rem;
      color: var(--teal);
      margin-top: 4px;
      font-family: var(--font-mono);
    }

    .sidebar-socials {
      display: flex; gap: 10px;
      margin: 1.25rem 0;
    }
    .sidebar-socials a {
      color: var(--text-2);
      font-size: 1rem;
      transition: color var(--transition);
      text-decoration: none;
    }
    .sidebar-socials a:hover { color: var(--accent); }

    .sidebar-meta {
      font-size: 0.75rem;
      color: var(--text-3);
      font-family: var(--font-mono);
      line-height: 1.8;
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .sidebar-meta span { color: var(--text-2); }

    .sidebar-nav {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .sidebar-nav a {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px;
      border-radius: var(--radius);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-2);
      transition: all var(--transition);
    }
    .sidebar-nav a:hover,
    .sidebar-nav a.active {
      background: var(--bg-3);
      color: var(--text);
    }
    .sidebar-nav a.active { color: var(--accent); }

    .sidebar-bottom {
      margin-top: auto;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .lang-toggle {
      display: flex;
      gap: 4px;
    }
    .lang-toggle a {
      font-size: 0.75rem;
      font-family: var(--font-mono);
      color: var(--text-3);
      text-decoration: none;
      padding: 3px 7px;
      border-radius: 4px;
      transition: all var(--transition);
    }
    .lang-toggle a.active,
    .lang-toggle a:hover {
      background: var(--bg-3);
      color: var(--text);
    }

    .cv-btn {
      font-size: 0.75rem;
      font-family: var(--font-mono);
      color: var(--accent);
      text-decoration: none;
      padding: 4px 10px;
      border: 1px solid var(--accent-2);
      border-radius: 4px;
      transition: all var(--transition);
    }
    .cv-btn:hover { background: var(--accent-2); color: #fff; }

    /* ── Main content ── */
    #main {
      margin-left: var(--nav-w);
      flex: 1;
      max-width: 860px;
      padding: 3rem 3rem 5rem;
    }

    /* ── Mobile nav ── */
    #mobile-nav-toggle {
      display: none;
      position: fixed;
      top: 1rem; right: 1rem;
      z-index: 200;
      background: var(--bg-2);
      border: 1px solid var(--border-2);
      border-radius: var(--radius);
      padding: 8px 10px;
      cursor: pointer;
      color: var(--text);
      font-size: 1.2rem;
    }

    @media (max-width: 768px) {
      :root { --nav-w: 100%; }
      #sidebar {
        transform: translateX(-100%);
        transition: transform 0.25s ease;
        width: 80vw;
        max-width: 300px;
      }
      #sidebar.open { transform: translateX(0); }
      #main { margin-left: 0; padding: 5rem 1.25rem 3rem; max-width: 100%; }
      #mobile-nav-toggle { display: block; }
    }

    /* ── Typography ── */
    h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; line-height: 1.1; }
    h2 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.25rem; }
    h3 { font-size: 1rem; font-weight: 500; }
    p  { font-size: 0.9375rem; line-height: 1.75; color: var(--text-2); }

    /* ── Utilities ── */
    .tag {
      display: inline-block;
      font-size: 0.7rem;
      font-family: var(--font-mono);
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid var(--border-2);
      color: var(--text-2);
      background: var(--bg-3);
    }
    .section { margin-bottom: 3.5rem; }
    .section-heading {
      font-size: 0.65rem;
      font-family: var(--font-mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-3);
      margin-bottom: 1.25rem;
    }
    .card {
      background: var(--bg-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.25rem 1.5rem;
    }
    .card + .card { margin-top: 10px; }

    a { color: var(--accent); }
    code { font-family: var(--font-mono); font-size: 0.85em; }
  </style>
</head>
<body>

  <!-- Mobile toggle -->
  <button id="mobile-nav-toggle" aria-label="Toggle navigation">☰</button>

  <!-- Sidebar -->
  <aside id="sidebar">
    <div class="sidebar-avatar">
      <!-- [REPLACE] swap src with your real photo once you have it -->
      DU
    </div>

    <p class="sidebar-name">{siteConfig.name}</p>
    <p class="sidebar-title">{siteConfig.title[lang]}</p>

    <div class="sidebar-socials">
      <a href={siteConfig.social.github}   aria-label="GitHub"   target="_blank" rel="noopener">GH</a>
      <a href={siteConfig.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener">LI</a>
      {siteConfig.social.twitter && (
        <a href={siteConfig.social.twitter} aria-label="X / Twitter" target="_blank" rel="noopener">X</a>
      )}
    </div>

    <div class="sidebar-meta">
      <div>✉ <span>{siteConfig.email}</span></div>
      <div>◎ <span>{siteConfig.location[lang]}</span></div>
      <div style="margin-top:8px; color: var(--teal);">
        {siteConfig.availableForWork
          ? (lang === "en" ? "● Open to work" : "● Disponible")
          : (lang === "en" ? "○ Not available" : "○ No disponible")}
      </div>
    </div>

    <nav aria-label="Main navigation">
      <ul class="sidebar-nav">
        {[
          { href: `/${lang}/`,          label: t.nav.about     },
          { href: `/${lang}/resume/`,   label: t.nav.resume    },
          { href: `/${lang}/portfolio/`,label: t.nav.portfolio },
          { href: `/${lang}/blog/`,     label: t.nav.blog      },
          { href: `/${lang}/contact/`,  label: t.nav.contact   },
        ].map(({ href, label }) => (
          <li>
            <a href={href} class={Astro.url.pathname === href ? "active" : ""}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="sidebar-bottom">
      <div class="lang-toggle">
        <a href={Astro.url.pathname.replace(`/${lang}`, "/en")} class={lang === "en" ? "active" : ""}>EN</a>
        <a href={Astro.url.pathname.replace(`/${lang}`, "/es")} class={lang === "es" ? "active" : ""}>ES</a>
      </div>
      <a href={siteConfig.cvUrl} class="cv-btn" download>CV ↓</a>
    </div>
  </aside>

  <!-- Main -->
  <main id="main">
    <slot />
  </main>

  <script>
    const toggle = document.getElementById("mobile-nav-toggle");
    const sidebar = document.getElementById("sidebar");
    toggle?.addEventListener("click", () => sidebar?.classList.toggle("open"));
  </script>
</body>
</html>
