---
import { siteConfig, ui } from "../data/site";

interface Props {
  lang: "en" | "es";
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const pageTitle = title
  ? `${title} — ${siteConfig.name}`
  : `${siteConfig.name} — ${siteConfig.title[lang]}`;
const pageDesc = description ?? siteConfig.description[lang];
const canonical = `${siteConfig.url}${Astro.url.pathname}`;
const altLang = lang === "en" ? "es" : "en";
const altPath = Astro.url.pathname.replace(`/${lang}`, `/${altLang}`);

const navItems = [
  { href: `/${lang}/`,           label: t.nav.about },
  { href: `/${lang}/resume/`,    label: t.nav.resume },
  { href: `/${lang}/portfolio/`, label: t.nav.portfolio },
  { href: `/${lang}/talks/`,     label: t.nav.talks },
  { href: `/${lang}/blog/`,      label: t.nav.blog },
  { href: `/${lang}/contact/`,   label: t.nav.contact },
];

const currentPath = Astro.url.pathname;
const buildTime = new Date().toISOString().slice(0, 10);
const buildVersion = import.meta.env.GITHUB_SHA?.slice(0, 7) ?? "dev";
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={altLang} href={`${siteConfig.url}${altPath}`} />
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:title"       content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    // Applied before paint so the sheet never flashes the wrong theme.
    if (localStorage.getItem("theme") === "dark") document.documentElement.classList.add("dark");
  </script>
</head>
<body>

<a href="#main" class="skip-link">{lang === "en" ? "Skip to content" : "Saltar al contenido"}</a>

<!-- ═══════════════════════════════════════
     TITLE BAR — drafting sheet header
════════════════════════════════════════ -->
<header class="title-bar">
  <a href={`/${lang}/`} class="mark">
    <img src="/personal-photo.jpeg" alt="" class="mark-photo" />
    <span class="mark-text">D. Aguirre</span>
    <span class="mark-sub">{lang === "en" ? "Platform blueprint" : "Plano de plataforma"}</span>
  </a>

  <nav class="top-nav" aria-label="Main navigation">
    {navItems.map(item => {
      const isActive = currentPath === item.href ||
        (item.href !== `/${lang}/` && currentPath.startsWith(item.href));
      return <a href={item.href} class={`nav-item ${isActive ? "active" : ""}`}>{item.label}</a>;
    })}
  </nav>

  <div class="bar-tools">
    <button id="theme-toggle" aria-label={lang === "en" ? "Toggle theme" : "Cambiar tema"}>
      <svg id="icon-dark" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg id="icon-light" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <div class="lang-toggle">
      <a href={currentPath.replace(`/${lang}`, "/es")} class={lang === "es" ? "active" : ""}>ES</a>
      <span class="lang-sep">/</span>
      <a href={currentPath.replace(`/${lang}`, "/en")} class={lang === "en" ? "active" : ""}>EN</a>
    </div>
    <button id="mobile-toggle" aria-label="Menu" aria-expanded="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</header>

<nav id="mobile-nav" aria-label="Mobile navigation">
  {navItems.map(item => <a href={item.href}>{item.label}</a>)}
</nav>

<!-- ═══════════════════════════════════════
     SHEET BODY
════════════════════════════════════════ -->
<main id="main">
  <slot />
</main>

<!-- ═══════════════════════════════════════
     TITLE BLOCK — the drafting footer
════════════════════════════════════════ -->
<footer class="title-block">
  <div class="tb-cell">
    <span class="tb-label">{lang === "en" ? "Drawn by" : "Dibujado por"}</span>
    <span class="tb-value">{siteConfig.name}</span>
  </div>
  <div class="tb-cell">
    <span class="tb-label">{lang === "en" ? "Location" : "Ubicación"}</span>
    <span class="tb-value">{siteConfig.location[lang]} · UTC−5</span>
  </div>
  <div class="tb-cell">
    <span class="tb-label">{lang === "en" ? "Status" : "Estado"}</span>
    <span class="tb-value tb-status">
      <span class="status-dot" aria-hidden="true"></span>
      {siteConfig.availableForWork ? t.common.available : t.common.notAvailable}
    </span>
  </div>
  <div class="tb-cell">
    <span class="tb-label">Rev.</span>
    <span class="tb-value"><code>{buildVersion}</code> · {buildTime}</span>
  </div>
  <div class="tb-cell tb-links">
    <a href={siteConfig.social.github} target="_blank" rel="noopener" aria-label="GitHub">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48v-1.7C6.73 19.91 6.14 18 6.14 18c-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85.004 1.71.115 2.51.337 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10z"/></svg>
    </a>
    <a href={siteConfig.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
    </a>
    <a href={`mailto:${siteConfig.email}`} aria-label="Email">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14"/><path d="m3 7 9 6 9-6"/></svg>
    </a>
  </div>
</footer>

<script>
  const html      = document.documentElement;
  const themeBtn  = document.getElementById("theme-toggle");
  const iconDark  = document.getElementById("icon-dark") as HTMLElement;
  const iconLight = document.getElementById("icon-light") as HTMLElement;

  function paintIcons(isDark: boolean) {
    iconDark.style.display  = isDark ? "none"  : "block";
    iconLight.style.display = isDark ? "block" : "none";
  }
  paintIcons(html.classList.contains("dark"));

  themeBtn?.addEventListener("click", () => {
    const isDark = html.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    paintIcons(isDark);
  });

  const toggle = document.getElementById("mobile-toggle");
  const mnav   = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = mnav?.classList.toggle("open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>

<style is:global>
  /* Layer order decides the cascade once and for all: a page's own scoped
     <style> is unlayered, so it always wins over everything declared here.
     That is why this file needs no !important anywhere. */
  @layer tokens, base, layout, components;

  @layer tokens {
    :root {
      /* ── Blueprint, light: ink on paper ── */
      --bg:          #f2f0e9;
      --bg-2:        #e9e6dc;
      --bg-3:        #dfdbcd;
      --text:        #16181a;
      --text-2:      #45483f;
      --text-3:      #6b665a;
      --rule:        #16181a;   /* structural hairlines — the signature */
      --rule-2:      #c4bfae;   /* soft rules, dividers */
      --grid:        #dcd8cc;   /* graph paper */
      --accent:      #1b4d3e;
      --accent-ink:  #f2f0e9;
      --accent-soft: rgba(27, 77, 62, 0.09);

      --font-sans: "IBM Plex Sans", system-ui, sans-serif;
      --font-mono: "IBM Plex Mono", ui-monospace, monospace;

      --sheet-w:   1280px;
      --pad:       clamp(1.25rem, 4vw, 4rem);
      --ease:      140ms ease;
    }

    /* ── Blueprint, dark: a drawing lit from behind ── */
    html.dark {
      --bg:          #14171a;
      --bg-2:        #1b1f22;
      --bg-3:        #242a2d;
      --text:        #e6e4dc;
      --text-2:      #a8ada4;
      --text-3:      #757a72;
      --rule:        #4c5552;
      --rule-2:      #2b3235;
      --grid:        #1d2225;
      --accent:      #6ee7a8;
      --accent-ink:  #0d1014;
      --accent-soft: rgba(110, 231, 168, 0.11);
    }
  }

  @layer base {
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      /* Graph paper. Sits behind every sheet. */
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* IBM Plex Sans is humanist, not geometric: it needs looser tracking than a
       grotesque would at the same size, or the counters close up. */
    h1, h2, h3 { font-weight: 700; letter-spacing: -0.018em; line-height: 1.06; }
    h1 { font-size: clamp(2.25rem, 4.7vw, 4.25rem); text-wrap: balance; }
    h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
    h3 { font-size: 1.0625rem; letter-spacing: -0.008em; line-height: 1.32; }

    p { font-size: 1rem; line-height: 1.72; color: var(--text-2); }
    a { color: var(--accent); }
    code { font-family: var(--font-mono); font-size: 0.85em; }
    img { max-width: 100%; }

    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .skip-link {
      position: absolute; top: -100px; left: 0; z-index: 400;
      background: var(--accent); color: var(--accent-ink);
      padding: 10px 16px; font-family: var(--font-mono); font-size: 0.75rem;
      text-decoration: none;
    }
    .skip-link:focus { top: 0; }
  }

  @layer layout {
    /* ── Title bar ── */
    .title-bar {
      display: flex; align-items: stretch; justify-content: space-between;
      border-bottom: 1px solid var(--rule);
      background: var(--bg);
      position: sticky; top: 0; z-index: 200;
    }

    .mark {
      display: flex; align-items: center; gap: 11px;
      padding: 0 20px 0 var(--pad);
      text-decoration: none; color: var(--text);
      border-right: 1px solid var(--rule-2);
    }
    .mark-photo {
      width: 26px; height: 26px; object-fit: cover; object-position: top;
      border: 1px solid var(--rule); filter: grayscale(1) contrast(1.05);
    }
    .mark-text {
      font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500;
      letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;
    }
    .mark-sub {
      font-family: var(--font-mono); font-size: 0.6875rem;
      letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3);
      white-space: nowrap;
    }

    .top-nav { display: flex; align-items: stretch; margin-left: auto; }
    .nav-item {
      display: flex; align-items: center;
      padding: 15px 20px;
      font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--text-3); text-decoration: none;
      border-left: 1px solid var(--rule-2);
      transition: color var(--ease), background var(--ease);
    }
    .nav-item:hover { color: var(--text); background: var(--bg-2); }
    .nav-item.active {
      color: var(--accent); background: var(--accent-soft);
      box-shadow: inset 0 -2px 0 var(--accent);
    }

    .bar-tools {
      display: flex; align-items: center; gap: 12px;
      padding: 0 var(--pad) 0 18px;
      border-left: 1px solid var(--rule-2);
    }
    #theme-toggle {
      display: flex; align-items: center; justify-content: center;
      width: 27px; height: 27px;
      background: transparent; border: 1px solid var(--rule-2);
      color: var(--text-2); cursor: pointer;
      transition: color var(--ease), border-color var(--ease);
    }
    #theme-toggle:hover { color: var(--accent); border-color: var(--accent); }

    .lang-toggle {
      display: flex; align-items: center; gap: 5px;
      font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em;
    }
    .lang-toggle a { color: var(--text-3); text-decoration: none; transition: color var(--ease); }
    .lang-toggle a.active { color: var(--text); }
    .lang-toggle a:hover { color: var(--accent); }
    .lang-sep { color: var(--rule-2); }

    #mobile-toggle {
      display: none; align-items: center; justify-content: center;
      width: 27px; height: 27px;
      background: transparent; border: 1px solid var(--rule-2);
      color: var(--text); cursor: pointer;
    }

    #mobile-nav { display: none; }

    /* ── Sheet body ── */
    #main {
      flex: 1;
      width: 100%;
      max-width: var(--sheet-w);
      margin: 0 auto;
      padding: clamp(2.5rem, 6vw, 5rem) var(--pad) clamp(4rem, 8vw, 6.5rem);
    }

    /* ── Title block ── */
    .title-block {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
      border-top: 1px solid var(--rule);
      background: var(--bg-2);
    }
    .tb-cell {
      display: flex; flex-direction: column; gap: 5px;
      padding: 14px 20px;
      border-right: 1px solid var(--rule-2);
    }
    .tb-cell:last-child { border-right: none; }
    .tb-label {
      font-family: var(--font-mono); font-size: 0.625rem;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3);
    }
    .tb-value { font-size: 0.8125rem; font-weight: 500; color: var(--text); }
    .tb-value code { color: var(--accent); }
    .tb-status { display: inline-flex; align-items: center; gap: 8px; color: var(--accent); }
    .tb-links { flex-direction: row; align-items: center; gap: 16px; padding-right: var(--pad); }
    .tb-links a { color: var(--text-3); display: flex; transition: color var(--ease); }
    .tb-links a:hover { color: var(--accent); }
  }

  @layer components {
    /* ── Sheet heading: eyebrow + title + lede ── */
    .eyebrow {
      display: flex; align-items: center; gap: 11px;
      font-family: var(--font-mono); font-size: 0.6875rem;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3);
      margin-bottom: 1.75rem;
    }
    .eyebrow::before {
      content: ""; width: 28px; height: 1px; background: var(--text-3); flex-shrink: 0;
    }
    .lede {
      font-size: 1.0625rem; line-height: 1.75; color: var(--text-2);
      max-width: 46ch; margin-top: 1.75rem;
    }

    /* ── Panel: a bordered drawing with its own header strip ── */
    .panel { border: 1px solid var(--rule); background: var(--bg); }
    .panel-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; padding: 11px 18px;
      border-bottom: 1px solid var(--rule); background: var(--bg-2);
    }
    .panel-title {
      font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--text);
    }
    .panel-note {
      font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-3);
    }

    /* ── Cells: bordered compartments. The 1px gap over a ruled background
       draws every divider, with no edge cases when the grid wraps. ── */
    .cells { display: grid; gap: 1px; background: var(--rule-2); }
    .cells-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cells-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cells-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .cell { padding: 1.5rem 1.375rem; background: var(--bg); }

    /* ── Figures: the big drafted numbers ── */
    .figure-value {
      font-size: clamp(2.5rem, 4.5vw, 3.5rem); font-weight: 700;
      letter-spacing: -0.028em; line-height: 0.95; color: var(--text);
    }
    .figure-value .unit { color: var(--accent); }
    .figure-label {
      font-family: var(--font-mono); font-size: 0.6875rem;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-3);
      margin-top: 0.875rem;
    }

    /* ── Tag: a dimension label ── */
    .tag {
      display: inline-block;
      max-width: 100%;
      font-family: var(--font-mono); font-size: 0.6875rem;
      padding: 3px 8px; border: 1px solid var(--rule-2);
      color: var(--text-2); background: var(--bg);
      /* No nowrap: long cert names ("GitHub Advanced Security") must wrap
         inside their cell instead of pushing the page sideways on a phone. */
      overflow-wrap: break-word;
    }

    /* Vendor accents, declared once. class={`tag cert-${group.color}`} */
    .cert-cncf   { color: #2f6fd0; border-color: #2f6fd0; }
    .cert-hashi  { color: #6b4fd8; border-color: #6b4fd8; }
    .cert-azure  { color: #1f6fa8; border-color: #1f6fa8; }
    .cert-aws    { color: #a86a12; border-color: #a86a12; }
    .cert-gcp    { color: #b03a2e; border-color: #b03a2e; }
    .cert-github { color: var(--text-2); border-color: var(--text-2); }
    .cert-gray   { color: var(--text-3); border-color: var(--rule-2); }

    html.dark .cert-cncf   { color: #6aa8f5; border-color: #6aa8f5; }
    html.dark .cert-hashi  { color: #a78bfa; border-color: #a78bfa; }
    html.dark .cert-azure  { color: #7dd3fc; border-color: #7dd3fc; }
    html.dark .cert-aws    { color: #f5a623; border-color: #f5a623; }
    html.dark .cert-gcp    { color: #f07167; border-color: #f07167; }

    /* Vendor name, same palette, as a heading */
    .vendor { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.01em; }
    .vendor-cncf   { color: #2f6fd0; }
    .vendor-hashi  { color: #6b4fd8; }
    .vendor-azure  { color: #1f6fa8; }
    .vendor-aws    { color: #a86a12; }
    .vendor-gcp    { color: #b03a2e; }
    .vendor-github { color: var(--text); }
    .vendor-gray   { color: var(--text-3); }

    html.dark .vendor-cncf  { color: #6aa8f5; }
    html.dark .vendor-hashi { color: #a78bfa; }
    html.dark .vendor-azure { color: #7dd3fc; }
    html.dark .vendor-aws   { color: #f5a623; }
    html.dark .vendor-gcp   { color: #f07167; }

    /* ── Buttons: hard-edged, ganged together ── */
    .btn-row { display: flex; border: 1px solid var(--rule); width: fit-content; }
    .btn {
      display: inline-flex; align-items: center; gap: 9px;
      padding: 13px 22px;
      font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--text); text-decoration: none; background: transparent;
      border: none; border-left: 1px solid var(--rule); cursor: pointer;
      transition: background var(--ease), color var(--ease);
    }
    .btn:first-child { border-left: none; }
    .btn:hover { background: var(--bg-2); }
    .btn-primary { background: var(--accent); color: var(--accent-ink); }
    .btn-primary:hover { background: var(--text); color: var(--bg); }

    .status-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--accent); flex-shrink: 0;
    }
  }

  /* ══════════════════════════════
     RESPONSIVE
  ══════════════════════════════ */
  @layer layout {
    @media (max-width: 1080px) {
      .mark-sub { display: none; }
